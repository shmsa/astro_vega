{
  "name": "astro-vega-web-bridge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "node -e 'require(\"fs\").rmSync(\".next/cache\", {recursive: true, force: true})' && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:math": "tsc -p tsconfig.math-test.json && node tests/math-golden.cjs",
    "test:profiles": "node tests/profiles.cjs",
    "test:all": "npm run test:math && npm run test:profiles && npm run test:provider",
    "test:provider": "tsc -p tsconfig.provider-test.json && node tests/provider-contract.cjs",
    "test:wasm-real": "tsc -p tsconfig.real-wasm.json && node tests/real-wasm-golden.mjs",
    "test:auth": "node --env-file=.env.local tests/auth-real.mjs",
    "test:crud": "node --env-file=.env.local tests/crud-rls.mjs",
    "test:regression": "tsc -p tsconfig.math-test.json && tsc -p tsconfig.real-wasm.json && node --env-file=.env.local tests/regression-sergio.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@swisseph/browser": "^1.3.1",
    "next": "16.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}

{
  "name": "astro-vega-web-bridge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:math": "tsc -p tsconfig.math-test.json && node tests/math-golden.cjs",
    "test:profiles": "node tests/profiles.cjs",
    "test:all": "npm run test:math && npm run test:profiles && npm run test:provider",
    "test:provider": "tsc -p tsconfig.provider-test.json && node tests/provider-contract.cjs",
    "test:wasm-real": "tsc -p tsconfig.real-wasm.json && node tests/real-wasm-golden.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@swisseph/browser": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
